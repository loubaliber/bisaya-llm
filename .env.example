# Copy to .env and fill in. Never commit the real .env file.

# Hugging Hub Face token with write access (for dataset/model uploads)
HF_TOKEN=

# Optional: override the User-Agent sent by the scraper
SCRAPER_USER_AGENT=

# Optional: Weights & Biases API key, if training_args.report_to includes "wandb"
WANDB_API_KEY=

# Set to "true" only once you have written permission from a rights holder
# to publicly redistribute scraped dictionary content. See docs/LEGAL_NOTICE.md
I_HAVE_REDISTRIBUTION_PERMISSION=false
